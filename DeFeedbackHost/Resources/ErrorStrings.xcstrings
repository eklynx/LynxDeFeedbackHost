      }
    },
    "pluginNotFoundFormat" : {
      "comment" : "The De-Feedback plugin is not installed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The “%1$(pluginName)@“ plugin is not installed. Please install it."
          }
        }
      }
    },
    "sampleRateMismatchFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The input sample rate %1$(inputRate)lld Hz and the output sample rate %2$(outputRate)lld Hz must match.\n"
          }
        }
      }
