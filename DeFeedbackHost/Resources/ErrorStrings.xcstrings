    "microphoneAccessDenied" : {
      "comment" : "Privacy permissions are blocking audio input/output",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeFeedbackHost needs audio input access. Grant it in System Settings › Privacy & Security › Microphone."
          }
        }
      }
    },
    "noDeviceSelected" : {
      "comment" : "An audio device (either input or output) its not set.",
