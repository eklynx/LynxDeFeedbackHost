<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Restart after crash" agent. Deliberately has NO RunAtLoad: it is only started on demand
	     (`launchctl kickstart`) by the app's launch handoff, then keeps the process alive after
	     abnormal exits. A normal quit exits 0 and is therefore not restarted. -->
	<key>Label</key>
	<string>com.eklynx.sound.DeFeedbackHost.supervisor</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/DeFeedbackHost</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.eklynx.sound.DeFeedbackHost</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
